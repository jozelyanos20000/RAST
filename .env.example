# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret-string
JWT_SECRET_KEY=change-me-to-a-different-random-secret-string
FLASK_ENV=production

# Database
DATABASE_URL=rast.db

# Seed account
RAST_SEED_PASSWORD=change-me-to-a-secure-password

# CORS (comma-separated allowed origins)
CORS_ORIGINS=https://your-app.up.railway.app

# Frontend (Vite, development only)
VITE_API_URL=http://localhost:5000

# Cloudfare R2
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=rast-audio
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
