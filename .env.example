# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret-string
JWT_SECRET_KEY=change-me-to-a-different-random-secret
FLASK_ENV=production

# Database
DATABASE_URL=rast.db

# Seed account
RAST_SEED_PASSWORD=change-me-to-a-secure-password

# CORS (comma-separated allowed origins)
CORS_ORIGINS=https://your-app.up.railway.app

# Frontend (Vite, development only)
VITE_API_URL=http://localhost:5000
